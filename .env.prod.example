# PostgreSQL
POSTGRES_DB=apni_kirana_store
POSTGRES_USER=postgres
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_THIS_POSTGRES_PASSWORD

# Redis
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# Backend
NODE_ENV=production
PORT=3000
# Keep the password here in sync with POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://postgres:CHANGE_THIS_POSTGRES_PASSWORD@postgres:5432/apni_kirana_store
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD@redis:6379
JWT_ACCESS_SECRET=CHANGE_THIS_64CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_DIFFERENT_64CHAR_STRING

# ─── SMS provider for OTP ─────────────────────────────────────────────────
# Pick ONE provider and set SMS_PROVIDER + that provider's credentials.
#   CONSOLE   = log to backend stdout (DEV ONLY — never set this in prod)
#   TWOFACTOR = 2Factor.in (free 100/day, India) — recommended for India launch
#   MSG91     = MSG91 (~₹0.18/OTP, India, no daily cap) — for higher volume
#   TWILIO    = international, ~₹3.30/OTP in India
# See docs/deployment.md § SMS OTP setup for sign-up steps.
SMS_PROVIDER=TWOFACTOR

# 2Factor.in — required when SMS_PROVIDER=TWOFACTOR
SMS_PROVIDER=TWOFACTOR
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=

# MSG91 — required when SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Twilio — required when SMS_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Cloudinary (image uploads) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Firebase (FCM fallback for raw FCM tokens) ──────────────────────────
# Optional: only needed if you want to receive raw FCM tokens (not Expo
# tokens). Mobile apps use Expo Push by default which doesn't need Firebase.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Web Push for admin browser (VAPID keys) ─────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys --json
# Don't rotate without re-subscribing every browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ─── Razorpay (payments) ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Email (password-reset links) ────────────────────────────────────────
# EMAIL_PROVIDER=RESEND in production. RESEND_API_KEY from resend.com -> API
# Keys. EMAIL_FROM must use a domain verified in the Resend dashboard
# (Domains tab + DNS records); for a quick start leave EMAIL_FROM blank to use
# Resend's shared onboarding sender. See docs/deployment.md § Email setup.
EMAIL_PROVIDER=RESEND
RESEND_API_KEY=
EMAIL_FROM=Apni Kirana Store <noreply@yourdomain.com>

# Base URL of the web app hosting the public /reset-password page —
# password-reset emails link here. Use the admin domain.
WEB_APP_URL=https://admin.yourdomain.com

# Comma-separated list of allowed origins. Include every web surface that
# calls the API directly from the browser.
CORS_ORIGIN=https://admin.yourdomain.com,https://quickeasymart.com,https://store.quickeasymart.com,https://driver.quickeasymart.com

# ─── Admin (Next.js) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ─── Customer storefront (Next.js — apps/customer-web) ───────────────────
# Public API base URL inlined into the customer storefront bundle at build
# time. Use the api subdomain of the customer-facing brand (quickeasymart.com).
NEXT_PUBLIC_API_URL_CUSTOMER=https://api.quickeasymart.com

# ─── Store operator dashboard (Next.js — apps/store-web) ─────────────────
# Public API base URL inlined into the store-web bundle at build time.
# Used by store owners on store.quickeasymart.com (the partner subdomain).
NEXT_PUBLIC_API_URL_STORE=https://api.quickeasymart.com

# ─── Driver web app (Next.js — apps/driver-web) ──────────────────────────
# Public API base URL inlined into the driver web bundle at build time.
# Used by drivers on driver.quickeasymart.com (the partner subdomain).
NEXT_PUBLIC_API_URL_DRIVER=https://api.quickeasymart.com
