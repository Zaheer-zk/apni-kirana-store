{
  "expo": {
    "name": "AKS Store",
    "slug": "apni-kirana-store-portal",
    "version": "1.0.0",
    "scheme": "apni-kirana-store",
    "orientation": "portrait",
    "icon": "./assets/apni-icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#2563EB",
    "splash": {
      "image": "./assets/apni-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apnikirana.storeportal",
      "infoPlist": {
        "NSCameraUsageDescription": "AKS Store uses your camera to capture product images.",
        "NSPhotoLibraryUsageDescription": "AKS Store needs access to your photo library to select product images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/apni-adaptive.png",
        "backgroundColor": "#16A34A"
      },
      "package": "com.apnikirana.storeportal",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "useNextNotificationsApi": true,
      "edgeToEdgeEnabled": false,
      "statusBar": {
        "translucent": false,
        "backgroundColor": "#FFFFFF",
        "barStyle": "dark-content"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/apni-favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "AKS Store needs access to your photos to upload product images.",
          "cameraPermission": "AKS Store needs camera access to capture product images."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AKS Store needs camera access to capture product images."
        }
      ],
      "expo-document-picker",
      "expo-asset",
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
