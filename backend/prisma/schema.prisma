generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STORE_OWNER
  DRIVER
  ADMIN
}

enum StoreCategory {
  GROCERY
  PHARMACY
  GENERAL
  RESTAURANT
}

enum StoreStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum ItemCategory {
  GROCERY
  MEDICINE
  HOUSEHOLD
  SNACKS
  BEVERAGES
  ELECTRONICS
  OTHER
}

enum OrderStatus {
  PENDING
  STORE_ACCEPTED
  // Hotel/restaurant workflow only: store accepted → now cooking the
  // food. Sits between STORE_ACCEPTED and DRIVER_ASSIGNED. Skipped
  // entirely for non-RESTAURANT stores (the lifecycle stays
  // PENDING → STORE_ACCEPTED → DRIVER_ASSIGNED → ...). Customer
  // tracking timeline + driver UI conditionally show this step based
  // on the order's store.category.
  COOKING
  DRIVER_ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
  REJECTED
}

// CUSTOMER  = a regular hyperlocal order placed by a customer.
// RESTOCK   = a B2B order a store owner places with a wholesaler to refill stock.
enum OrderType {
  CUSTOMER
  RESTOCK
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VehicleType {
  BIKE       // motorcycle / motorbike (the default for the Indian "delivery bike")
  SCOOTER    // gearless 2-wheeler (Activa-class)
  CAR
  BICYCLE    // pedal bicycle — slower legs, no fuel cost
  ON_FOOT    // pedestrian — used for short hyperlocal hops in tight markets
}

enum DriverStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  OFFLINE
  ONLINE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                 String     @id @default(cuid())
  name               String?
  // One phone number / email / username can each hold multiple roles, but
  // every (phone, role), (email, role) and (username, role) is its OWN row
  // with its own name/email/username/password. So none of phone / email /
  // username are unique on their own — the composite `@@unique([X, role])`
  // indexes below enforce "at most one of each role per identifier". `roles`
  // is kept as a `[role]` denormalisation for backward-compat with code that
  // checks `user.roles.includes(...)`.
  //
  // Phone is nullable so an email-only account is possible in the future.
  // Today every registration still requires phone (validated in the route),
  // but the schema doesn't.
  phone              String?
  email              String? // used for password-reset, login; unique per (email, role)
  role               UserRole   @default(CUSTOMER)
  roles              UserRole[] @default([])
  username           String? // login id for username/password login; unique per (username, role)
  passwordHash       String? // bcrypt hash for username/password login
  // Admin-created accounts get a temporary password and must set their own on
  // first login. Also set when an admin resets a user's credentials.
  mustChangePassword Boolean    @default(false)
  // Exactly one account carries this. The super admin is an ADMIN that can
  // additionally create and manage other ADMIN accounts. Never exposed for
  // assignment via the API — set once, by migration.
  isSuperAdmin       Boolean    @default(false)
  // false until the registration OTP is verified. Existing users are backfilled
  // to true by the migration.
  phoneVerified      Boolean    @default(false)
  fcmToken           String?
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  addresses           Address[]
  orders              Order[]              @relation("CustomerOrders")
  orderGroups         OrderGroup[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  store               Store?
  driver              Driver?
  wallet              Wallet?
  catalogRequests     CatalogItemRequest[]

  @@unique([phone, role])
  @@unique([email, role])
  @@unique([username, role])
  @@index([phone])
  @@index([email])
  @@index([username])
}

// One row per password-reset request. The raw token is emailed to the user as
// a link; only its SHA-256 hash is stored here so a DB leak can't be used to
// reset accounts. Single-use (`usedAt`) and short-lived (`expiresAt`).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  street    String
  city      String
  state     String
  pincode   String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]
  orderGroups OrderGroup[]
}

model Store {
  id           String        @id @default(cuid())
  ownerId      String        @unique
  name         String
  description  String?
  category     StoreCategory
  lat          Float
  lng          Float
  street       String
  city         String
  state        String
  pincode      String
  status       StoreStatus   @default(PENDING_APPROVAL)
  isWholesaler Boolean       @default(false) // true = a wholesaler/workshop that retail stores restock from
  isPreferred  Boolean       @default(false) // admin-flagged; gets a scoring boost in the matching engine
  // Explicit zone the store belongs to. Nullable so legacy stores (pre-
  // zone-field) still resolve via the lat/lng geographic filter. Once set,
  // the matching engine prefers `zoneId` over the haversine radius check —
  // see backend/src/services/zone.service.ts:filterStoresByCustomerZone.
  // Driver→zone uses a many-to-many (DriverZone) because drivers serve
  // multiple zones; stores are anchored to ONE physical address so a
  // single-zone FK is the right fit.
  zoneId       String?
  openTime     String
  closeTime    String
  rating       Float         @default(0)
  totalRatings Int           @default(0)
  isOpen       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  owner       User        @relation(fields: [ownerId], references: [id])
  zone        Zone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  items            StoreItem[]
  orders           Order[]              @relation("StoreOrders") // orders this store received (as seller)
  buyerOrders      Order[]              @relation("BuyerStoreOrders") // restock orders this store placed (as buyer)
  catalogRequests  CatalogItemRequest[]

  @@index([lat, lng])
  @@index([isWholesaler])
  @@index([zoneId])
}

// Master product catalog managed by ADMIN.
// Stores select which catalog items they carry and set their own prices via StoreItem.
model CatalogItem {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  category    ItemCategory
  defaultUnit String
  imageUrl    String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  storeItems StoreItem[]
  // When admin approves a CatalogItemRequest, the resulting CatalogItem
  // gets linked back so the store sees 'your request became this item'.
  requests   CatalogItemRequest[]

  @@index([category])
  @@index([name])
}

// Store's selection from the master catalog with their own price + stock.
model StoreItem {
  id            String   @id @default(cuid())
  storeId       String
  catalogItemId String
  // What the store owner is paid per unit. Visible to the store owner as
  // "your payout" / "your price" and never shown to the customer raw —
  // customer-facing price is `price + adminMargin`.
  price         Float
  // Admin-set commission per unit on this exact StoreItem. Negotiated with
  // the store owner offline (per the 2026-06-02 pricing model decision).
  // Customer pays `price + adminMargin`; admin retains `adminMargin × qty`
  // per order line; store gets `price × qty`. Defaults to 0 so legacy items
  // continue to behave as before until admin sets a margin.
  adminMargin   Float    @default(0)
  stockQty      Int      @default(0)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([storeId, catalogItemId])
  @@index([storeId])
  @@index([catalogItemId])
}

model Order {
  id                String        @id @default(cuid())
  customerId        String
  storeId           String
  driverId          String?
  orderType         OrderType     @default(CUSTOMER)
  buyerStoreId      String? // set on RESTOCK orders: the retail store that placed the order
  // Multi-store grouping (2026-06-04). When the customer's cart spans
  // multiple stores AND no single store can fulfil it, the order-create
  // path creates one OrderGroup + N child Orders (one per store) sharing
  // this orderGroupId. Single-store orders leave it null and behave
  // exactly as before. Customer apps roll up by orderGroupId for the
  // unified timeline; driver gets a multi-pickup sequence; admin sees
  // per-store accept/reject. See backend/src/services/order-group.service.ts.
  orderGroupId      String?
  status            OrderStatus   @default(PENDING)
  subtotal          Float
  deliveryFee       Float
  commission        Float
  total             Float
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  paymentId         String?
  // COD reconciliation — admin flips this after physically receiving the
  // cash from the driver (per-order, so partial settlements are visible).
  // Only meaningful when paymentMethod = CASH_ON_DELIVERY; left false on
  // online-paid orders. Drives the "owed by driver" totals on the admin
  // money-flow + driver finance views.
  codCollected      Boolean       @default(false)
  codCollectedAt    DateTime?
  deliveryAddressId String
  notes             String?
  rejectionReason   String?
  cancelReason      String?
  dropoffOtp        String? // 4-digit OTP for driver-to-customer handoff verification
  // "Order for someone else" — driver/store call this number at dropoff if
  // set, instead of the account holder's phone. Falls back to customer's
  // phone when null.
  recipientName     String?
  recipientPhone    String?
  promoCode         String?
  promoDiscount     Float? // amount deducted by the applied promo (snapshot)
  // GST invoice — generated when status moves to DELIVERED. PDF stored
  // under backend/storage/invoices/ (a mounted volume in prod). Number is
  // unique per FY for compliance: e.g. "AKS/2026-27/000123".
  invoiceNumber     String?      @unique
  invoicePath       String?
  invoiceGeneratedAt DateTime?
  storeAcceptedAt   DateTime?
  // Set when the store marks the order packed & ready for pickup. Drives
  // the 'Mark as packed' button visibility on the store-web order detail
  // (button hides once set, so admin/staff can't fire it twice).
  packedAt          DateTime?
  // Set when a restaurant transitions an order to COOKING.
  cookingStartedAt  DateTime?
  driverAssignedAt  DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer        User                @relation("CustomerOrders", fields: [customerId], references: [id])
  store           Store               @relation("StoreOrders", fields: [storeId], references: [id])
  buyerStore      Store?              @relation("BuyerStoreOrders", fields: [buyerStoreId], references: [id])
  driver          Driver?             @relation(fields: [driverId], references: [id])
  items           OrderItem[]
  deliveryAddress Address             @relation(fields: [deliveryAddressId], references: [id])
  rating          OrderRating?
  walletTxns      WalletTransaction[] @relation("OrderWalletTxns")
  orderGroup      OrderGroup?         @relation(fields: [orderGroupId], references: [id])

  @@index([customerId, status])
  @@index([storeId, status])
  @@index([buyerStoreId])
  @@index([orderGroupId])
}

// Multi-store rollup. One per user-facing "order" that spans multiple
// stores. Carries the customer-visible aggregate (sum of children's
// subtotals, single deliveryFee, single dropoff address) so the UI can
// render one card per cart even though the DB has N child rows.
//
// Driver assignment: a SINGLE driver handles every leg of the group
// (sequential pickups → one delivery), so driverId lives on the group
// rather than per-child. Children inherit the driver via the group at
// runtime to avoid sync drift.
//
// Why not just denormalise on Order: we'd lose the ability to track
// per-store accept/reject deadlines and per-store COD splits cleanly.
// A dedicated parent table keeps the per-leg lifecycle on the existing
// Order row.
model OrderGroup {
  id                String        @id @default(cuid())
  customerId        String
  deliveryAddressId String
  // Lifecycle: PENDING (waiting for stores) → STORES_ACCEPTED (all in) →
  // DRIVER_ASSIGNED → PICKED_UP (driver finished last pickup) →
  // DELIVERED. Cancelled if any child cancels and the customer chooses
  // to abort the whole group (handled by the order-group service).
  status            OrderStatus   @default(PENDING)
  // Aggregated for the customer-facing summary. Each child Order still
  // carries its own slice for per-store payouts.
  subtotal          Float
  deliveryFee       Float
  total             Float
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  // The single driver carrying every leg of this group.
  driverId          String?
  // Mirrors Order.recipient* so the same dropoff contact applies to
  // every pickup leg.
  recipientName     String?
  recipientPhone    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer        User    @relation(fields: [customerId], references: [id])
  deliveryAddress Address @relation(fields: [deliveryAddressId], references: [id])
  driver          Driver? @relation(fields: [driverId], references: [id])
  orders          Order[]

  @@index([customerId, status])
  @@index([driverId])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  itemId   String?
  name     String
  price    Float
  unit     String
  qty      Int
  imageUrl String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Driver compensation model. PER_ORDER (default) — driver earns the
// delivery fee on each delivered order. SALARY — admin pays a fixed
// monthlyAmount, driver earns no per-delivery fee. Admin sets the model
// per driver from the admin dashboard (typically promotes a driver to
// SALARY after the 30-day / 3-orders-per-day-average eligibility).
enum DriverCompensationType {
  PER_ORDER
  SALARY
}

model Driver {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  vehicleType      VehicleType
  vehicleNumber    String
  licenseNumber    String
  status           DriverStatus           @default(PENDING_APPROVAL)
  // Compensation model — see DriverCompensationType. Defaults to PER_ORDER
  // so existing drivers keep their current arrangement until admin
  // explicitly promotes them.
  compensationType DriverCompensationType @default(PER_ORDER)
  // Fixed monthly amount when compensationType = SALARY. Null otherwise.
  // Admin sets this after the salary negotiation lands.
  monthlySalary    Float?
  currentLat       Float?
  currentLng       Float?
  rating           Float                  @default(0)
  totalRatings     Int                    @default(0)
  totalEarnings    Float                  @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
  orderGroups  OrderGroup[]
  payouts      Payout[]
  zones        DriverZone[]

  @@index([currentLat, currentLng])
}

// Many-to-many: drivers self-select which delivery zones they want to
// serve, admin can override. Matching engine filters offerable drivers by
// whether the order's store/dropoff falls inside any of the driver's zones.
// If a driver has zero rows here, they're treated as serving the whole
// city — backward-compat for existing drivers who registered before zones.
model DriverZone {
  driverId  String
  zoneId    String
  createdAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([driverId, zoneId])
  @@index([zoneId])
}

// Weekly aggregated driver payouts. Aggregator cron walks every driver
// once a week, sums deliveryFee on DELIVERED orders since the last payout
// (or driver creation), writes one Payout row per driver per week.
// Admin marks PAID once the bank transfer settles.
enum PayoutStatus {
  PENDING // generated by aggregator, awaiting admin action
  PAID    // admin has marked it as transferred
  FAILED  // admin attempted but the bank transfer bounced
}

model Payout {
  id            String       @id @default(cuid())
  driverId      String
  periodStart   DateTime     // inclusive
  periodEnd     DateTime     // exclusive
  orderCount    Int
  gross         Float        // sum of deliveryFee for delivered orders in period
  // Deductions: COD shortfall / damage / refund-share. Manual today; admin
  // can adjust before marking PAID.
  deductions    Float        @default(0)
  net           Float        // gross - deductions
  status        PayoutStatus @default(PENDING)
  reference     String?      // bank transfer ref / UTR
  notes         String?
  paidAt        DateTime?
  paidByUserId  String?      // admin who marked PAID
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, periodStart])
  @@index([status])
  @@index([driverId, periodEnd])
}

model OrderRating {
  id            String   @id @default(cuid())
  orderId       String   @unique
  customerId    String
  storeRating   Int
  driverRating  Int?
  storeComment  String?
  driverComment String?
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Dispatch tracking — one row per delivery attempt. The same logical
  // notification may fan out across multiple channels (in-app + expo push +
  // web push); each channel write is a separate row so per-channel failures
  // are visible in the admin dispatch log. `event` mirrors the
  // NotificationEvent TS union (see notification.service.ts).
  event     String? // e.g. "ORDER_PLACED", "STORE_NEW_ORDER"; null for legacy/ad-hoc
  channel   NotificationChannel @default(INAPP)
  status    NotificationStatus  @default(DELIVERED)
  error     String? // populated when status = FAILED

  @@index([userId, createdAt])
  @@index([event])
  @@index([channel])
  @@index([status])
}

enum NotificationChannel {
  INAPP // persisted in DB only — drives the bell icon
  PUSH // Expo push (mobile) or raw FCM
  WEBPUSH // browser web push (admin dashboard)
  SOCKET // socket.io real-time event (future)
  EMAIL // outbound email (future)
  SMS // outbound sms (future)
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
}

// Admin-created discount/promo code that customers can apply at checkout.
// Either flat (e.g. ₹50 off) or percentage (e.g. 10% off, capped at maxDiscount).
model Promo {
  id            String            @id @default(cuid())
  code          String            @unique
  description   String?
  discountType  DiscountType // FLAT or PERCENT
  discountValue Float // for FLAT: rupees off; for PERCENT: 0–100
  maxDiscount   Float? // cap for PERCENT discounts (rupees)
  minOrderValue Float             @default(0)
  usageLimit    Int? // total usage cap across all users; null = unlimited
  perUserLimit  Int? // per-customer usage cap; null = unlimited
  usedCount     Int               @default(0)
  validFrom     DateTime          @default(now())
  validUntil    DateTime?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  redemptions   PromoRedemption[]

  @@index([code])
  @@index([isActive])
}

model PromoRedemption {
  id        String   @id @default(cuid())
  promoId   String
  userId    String
  orderId   String   @unique
  discount  Float // actual amount discounted
  createdAt DateTime @default(now())

  promo Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@index([promoId, userId])
}

enum DiscountType {
  FLAT
  PERCENT
}

// Audit log for sensitive admin actions: manual assignments, suspensions,
// promo edits, refund issuance, etc.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String // user id of admin
  action     String // e.g. "ORDER_ASSIGN_STORE", "STORE_SUSPEND"
  targetType String? // "Order" | "Store" | "Driver" | "User" | "Promo"
  targetId   String?
  before     Json? // state before change (optional)
  after      Json? // state after change (optional)
  reason     String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Delivery zones — admin-configurable per city/area (radius + fee structure).
// Used for surge pricing, geofencing future expansion zones.
// Per-user notification toggles (one row per user). Server-side source of truth
// for what kinds of notifications to actually push (FCM / in-app).
model NotificationPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique
  // Common across roles
  orderUpdates        Boolean  @default(true)
  promotional         Boolean  @default(true)
  dailySummary        Boolean  @default(false)
  // Customer-specific
  driverUpdates       Boolean  @default(true)
  // Store-specific
  newOrderAlerts      Boolean  @default(true)
  rescindedAlerts     Boolean  @default(true)
  earningsSummary     Boolean  @default(false)
  // Driver-specific
  newDeliveryAlerts   Boolean  @default(true)
  payoutNotifications Boolean  @default(true)
  // Admin-specific
  newStoreApprovals   Boolean  @default(true)
  newDriverApprovals  Boolean  @default(true)
  refundEvents        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// In-app chat between order participants (customer ↔ store, customer ↔ driver,
// store ↔ driver). One Chat row per (orderId, participant pair).
//
// Retention: when the order reaches DELIVERED/CANCELLED/REJECTED we record
// `closedAt`. A scheduled job soft-deletes (sets `deletedAt`) 30 days after
// `closedAt` and hard-deletes 90 days after. Messages are stored in plain
// text (no encryption) so support / fraud-investigation can review.
model Chat {
  id        String    @id @default(cuid())
  orderId   String
  // The two participants — sorted alphabetically by id at insert time so the
  // unique constraint catches duplicates regardless of who sent the first
  // message. We don't enforce specific roles at the schema level — any pair
  // out of (customer, storeOwner, driverUser) is allowed.
  userAId   String
  userBId   String
  closedAt  DateTime? // set when the order reaches a terminal state
  deletedAt DateTime? // soft-delete marker (30d after closedAt)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages ChatMessage[]

  @@unique([orderId, userAId, userBId])
  @@index([orderId])
  @@index([userAId])
  @@index([userBId])
  @@index([deletedAt])
}

model ChatMessage {
  id        String    @id @default(cuid())
  chatId    String
  senderId  String
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

// Support thread between any user (customer / store_owner / driver) and
// the admin team. Each user has at most ONE open support thread at a time —
// admins reply from the inbox. Independent of order chats: this is for
// general help, complaints, account issues, etc.
//
// Status flow: OPEN → RESOLVED. Admin can re-open by sending a new message.
model SupportThread {
  id           String              @id @default(cuid())
  // The user reaching out. We don't store an adminId because any admin can
  // reply — see SupportMessage.senderId for who actually sent each message.
  userId       String              @unique
  status       SupportThreadStatus @default(OPEN)
  subject      String?
  // Last message preview + timestamp keep the inbox fast — no need to JOIN
  // ChatMessage to render the list.
  lastMessage  String?
  lastSenderId String?
  lastAt       DateTime?
  // Counts so admin sees unread badges per-thread
  userUnread   Int                 @default(0) // unread for the user (admin sent)
  adminUnread  Int                 @default(0) // unread for admins (user sent)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  messages SupportMessage[]

  @@index([status, lastAt])
  @@index([adminUnread])
}

enum SupportThreadStatus {
  OPEN
  RESOLVED
}

model SupportMessage {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// One row per device a user has installed the app on. We fan out mobile
// pushes to every Device for the recipient, so a user receives notifications
// on their phone + tablet etc. Token-dead errors delete just that one row.
//
// User.fcmToken is preserved as a denormalized "most-recent token" for
// backward compatibility with existing code paths; new code should read
// from Device.
model Device {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String? // 'ios' | 'android' | 'web' — free-form for now
  lastSeenAt DateTime @default(now()) @updatedAt
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Web push subscriptions for the admin browser (PushManager / service worker).
// Different from FCM — used by admin web app only.
model WebPushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Zone {
  id              String   @id @default(cuid())
  name            String   @unique
  city            String
  centerLat       Float
  centerLng       Float
  radiusKm        Float    @default(5)
  baseDeliveryFee Float    @default(30)
  perKmFee        Float    @default(0)
  commissionRate  Float    @default(0.10) // 10%
  // Subtotal (rupees) at which delivery becomes free for this zone.
  // 0 disables the perk; admin sets it per zone. The order-create math
  // zeroes deliveryFee when subtotal >= freeDeliveryThreshold > 0.
  freeDeliveryThreshold Float @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  drivers DriverZone[]
  stores  Store[]

  @@index([city])
  @@index([isActive])
}

// Platform-wide settings. Single row, id="default". Read on the order-create
// + matching paths via a cached service so toggles in the admin UI take
// effect without a backend restart.
model PlatformSetting {
  id                         String   @id @default("default")
  baseDeliveryFee            Float    @default(30)
  perKmFee                   Float    @default(5)
  commissionPercent          Float    @default(10)
  deliveryRadiusKm           Float    @default(5)
  storeAcceptTimeoutMinutes  Int      @default(3)
  driverAcceptTimeoutSeconds Int      @default(60)
  storeMatchingMode          String   @default("BROADCAST")
  driverMatchingMode         String   @default("BROADCAST")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// Customer / user wallet. Balance is stored in paise (₹1 = 100) so we never
// have to deal with floating-point rounding. One wallet per user, lazily
// created the first time we need to credit/debit (see wallet.service.ts).
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0) // paise (₹1 = 100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

enum WalletTxnKind {
  REFUND
  PROMO_CREDIT
  GOODWILL
  ORDER_PAYMENT
  ADJUSTMENT
}

// Append-only ledger of wallet movements. `amount` is signed paise: positive
// for credits, negative for debits. `balanceAfter` snapshots the wallet
// balance right after this transaction so a user-facing statement doesn't
// need to recompute from history.
model WalletTransaction {
  id           String        @id @default(cuid())
  walletId     String
  kind         WalletTxnKind
  amount       Int // signed paise
  balanceAfter Int
  orderId      String?
  note         String?
  actorId      String? // admin user id when credit/debit is a manual admin action
  createdAt    DateTime      @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order? @relation("OrderWalletTxns", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([orderId])
}

// Store owner asks admin to add a new item to the master catalog. Admin
// reviews → either approves (creates a CatalogItem + auto-adds it to the
// requester's StoreItem inventory) or rejects with a note. Distinct from
// CatalogItem.isActive: that's a soft-delete; this is the inbox where new
// items get born.
enum CatalogRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CatalogItemRequest {
  id          String               @id @default(cuid())
  storeId     String               // store that raised the request
  requestedBy String               // user id (the store owner)
  name        String
  description String?
  category    ItemCategory
  defaultUnit String
  imageUrl    String?
  // What the store currently sells it for — useful context for admin
  // when triaging requests across stores.
  priceHint   Float?
  status      CatalogRequestStatus @default(PENDING)
  reviewNote  String?              // admin's reason on APPROVE / REJECT
  reviewedBy  String?              // admin user id who actioned it
  reviewedAt  DateTime?
  // When APPROVED, links to the newly-created CatalogItem so we can
  // surface 'your request became this item' on the store side.
  catalogItemId String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requester User         @relation(fields: [requestedBy], references: [id])
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([status, createdAt])
}
